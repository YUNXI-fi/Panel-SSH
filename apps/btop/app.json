{
  "schemaVersion": 1,
  "slug": "btop",
  "name": "btop",
  "version": "1.0.0",
  "category": "monitor",
  "description": "终端资源监视器：CPU、内存、磁盘、网络与进程一屏看完",
  "note": "RHEL 系需要先启用 EPEL 仓库",
  "icon": "icon.svg",
  "defaultAction": "version",
  "config": [
    {
      "path": "~/.config/btop/btop.conf"
    }
  ],
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "btop --version 2\u003e/dev/null | head -1 | grep -oE '[0-9]+\\.[0-9.]+' 2\u003e/dev/null | head -1"
    }
  ]
}
