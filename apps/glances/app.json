{
  "schemaVersion": 1,
  "slug": "glances",
  "name": "Glances",
  "version": "1.0.0",
  "category": "monitor",
  "description": "跨平台系统监控，支持 Web 模式与导出指标",
  "note": "RHEL 系需要先启用 EPEL 仓库",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "glances --version 2\u003e/dev/null | head -1 | awk '{print $2}' 2\u003e/dev/null | head -1"
    }
  ]
}
