{
  "schemaVersion": 1,
  "slug": "pkgconf",
  "name": "pkg-config",
  "version": "1.0.0",
  "category": "toolchain",
  "description": "编译时查询库的编译与链接参数，很多源码构建流程依赖它",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "pkg-config --version 2\u003e/dev/null | head -1"
    }
  ]
}
