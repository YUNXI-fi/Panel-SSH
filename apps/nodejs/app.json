{
  "schemaVersion": 1,
  "slug": "nodejs",
  "name": "Node.js",
  "version": "1.0.0",
  "category": "runtime",
  "description": "Node.js 运行时与 npm，通过 NodeSource 官方仓库安装可选 LTS 大版本",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "node -v 2\u003e/dev/null | sed 's/^v//' 2\u003e/dev/null | head -1"
    }
  ]
}
