{
  "schemaVersion": 1,
  "slug": "golang",
  "name": "Go",
  "version": "1.0.0",
  "category": "runtime",
  "description": "Go 语言官方 tarball，安装到 /usr/local/go 并注册到 PATH，可选近期稳定版本",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "go version 2\u003e/dev/null | awk '{print $3}' | sed 's/^go//' 2\u003e/dev/null | head -1"
    }
  ]
}
