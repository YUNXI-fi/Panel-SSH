{
  "schemaVersion": 1,
  "slug": "maven",
  "name": "Maven",
  "version": "1.0.0",
  "category": "toolchain",
  "description": "Java 项目的依赖管理与构建工具",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "mvn -v | head -1 | awk '{print $3}' 2\u003e/dev/null | head -1"
    }
  ]
}
