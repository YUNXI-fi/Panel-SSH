{
  "schemaVersion": 1,
  "slug": "restic",
  "name": "restic",
  "version": "1.0.0",
  "category": "backup",
  "description": "加密去重的增量备份，支持本地目录与 S3 等后端",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "restic version | head -1 | awk '{print $2}' 2\u003e/dev/null | head -1"
    }
  ]
}
