{
  "schemaVersion": 1,
  "slug": "build-toolchain",
  "name": "构建工具链",
  "version": "1.0.0",
  "category": "toolchain",
  "description": "gcc/g++/make 等基础编译工具（Debian: build-essential；RHEL 系: Development Tools；Alpine: build-base）",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "gcc -dumpversion 2\u003e/dev/null 2\u003e/dev/null | head -1"
    }
  ]
}
