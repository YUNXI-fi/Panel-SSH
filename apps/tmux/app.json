{
  "schemaVersion": 1,
  "slug": "tmux",
  "name": "tmux",
  "version": "1.0.0",
  "category": "utility",
  "description": "终端复用器：断线后会话仍在，长任务不必挂着 SSH",
  "icon": "icon.svg",
  "defaultAction": "version",
  "config": [
    {
      "path": "~/.tmux.conf"
    }
  ],
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "tmux -V | awk '{print $2}' 2\u003e/dev/null | head -1"
    }
  ]
}
