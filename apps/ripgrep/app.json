{
  "schemaVersion": 1,
  "slug": "ripgrep",
  "name": "ripgrep",
  "version": "1.0.0",
  "category": "utility",
  "description": "高速递归文本搜索（rg），尊重 .gitignore",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "rg --version | head -1 | awk '{print $2}' 2\u003e/dev/null | head -1"
    }
  ]
}
