{
  "schemaVersion": 1,
  "slug": "mongodb",
  "name": "MongoDB",
  "version": "1.0.0",
  "category": "database",
  "description": "MongoDB 8.0 官方社区版（mongod），通过 MongoDB 自己的仓库安装（Alpine 仓库不提供）",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "mongod --version 2\u003e/dev/null | head -1 | sed -E 's/.*v([0-9.]+).*/\\1/' 2\u003e/dev/null | head -1"
    }
  ]
}
