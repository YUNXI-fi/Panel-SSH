{
  "schemaVersion": 1,
  "slug": "bun",
  "name": "Bun",
  "version": "1.0.0",
  "category": "runtime",
  "description": "Bun 运行时、包管理器与打包器，官方脚本安装到 /usr/local（CentOS 7 的 glibc 过旧，不在此支持）",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "/usr/local/bin/bun --version 2\u003e/dev/null | head -1"
    }
  ]
}
