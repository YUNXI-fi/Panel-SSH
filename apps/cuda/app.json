{
  "schemaVersion": 1,
  "slug": "cuda",
  "name": "CUDA Toolkit",
  "version": "1.0.0",
  "category": "toolchain",
  "description": "NVIDIA CUDA Toolkit（nvcc 等），用于 GPU 计算与编译；仅 x86_64，且不含显卡驱动",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "/usr/local/cuda/bin/nvcc --version 2\u003e/dev/null | tail -1 | sed -E 's/.*release ([0-9.]+).*/\\1/' 2\u003e/dev/null | head -1"
    }
  ]
}
