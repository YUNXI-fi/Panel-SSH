{
  "schemaVersion": 1,
  "slug": "cmake",
  "name": "CMake",
  "version": "1.0.0",
  "category": "toolchain",
  "description": "跨平台构建系统生成器",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "cmake --version | head -1 | awk '{print $3}' 2\u003e/dev/null | head -1"
    }
  ]
}
