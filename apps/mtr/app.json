{
  "schemaVersion": 1,
  "slug": "mtr",
  "name": "mtr",
  "version": "1.0.0",
  "category": "network",
  "description": "把 traceroute 与 ping 合成一屏，持续性观察每一跳的丢包与延迟",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "mtr --version 2\u003e\u00261 | head -1 | awk '{print $2}' 2\u003e/dev/null | head -1"
    }
  ]
}
