{
  "schemaVersion": 1,
  "slug": "borgbackup",
  "name": "BorgBackup",
  "version": "1.0.0",
  "category": "backup",
  "description": "去重压缩备份（borg），适合定期快照到远端仓库",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "borg --version 2\u003e/dev/null | awk '{print $2}' 2\u003e/dev/null | head -1"
    }
  ]
}
