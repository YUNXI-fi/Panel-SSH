{
  "schemaVersion": 1,
  "slug": "fzf",
  "name": "fzf",
  "version": "1.0.0",
  "category": "utility",
  "description": "模糊查找器，可用于历史命令、文件与任何列表的筛选",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "fzf --version | awk '{print $1}' 2\u003e/dev/null | head -1"
    }
  ]
}
