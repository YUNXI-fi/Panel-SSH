{
  "schemaVersion": 1,
  "slug": "socat",
  "name": "socat",
  "version": "1.0.0",
  "category": "network",
  "description": "多功能中继工具：端口转发、Unix socket、TLS 隧道",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "socat -V 2\u003e\u00261 | head -1 | awk '{print $3}' 2\u003e/dev/null | head -1"
    }
  ]
}
