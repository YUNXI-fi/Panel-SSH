{
  "schemaVersion": 1,
  "slug": "tree",
  "name": "tree",
  "version": "1.0.0",
  "category": "utility",
  "description": "以树状结构列出目录内容",
  "icon": "icon.svg",
  "defaultAction": "version",
  "actions": [
    {
      "id": "version",
      "label": "版本信息",
      "group": "inspect",
      "timeoutSec": 30,
      "command": "tree --version | awk '{print $2}' | sed 's/^v//' 2\u003e/dev/null | head -1"
    }
  ]
}
